# Base de datos de SIMIQ3D (local: el contenedor simiq3d-db, en el puerto 5433;
# en producción, su propio proyecto en Neon). Nunca la de DataIQ.
DATABASE_URL=postgresql+asyncpg://simiq3d:contraseña@localhost:5433/simiq3d
SQL_ECHO=false
# En Vercel va en false: cada función abre y cierra su conexión.
DATABASE_POOL=true
# Backend de DataIQ (local: el de dataiq/backend corriendo en el puerto 8000).
# De ahí sale la clave pública para validar los JWT: DATAIQ_URL/.well-known/jwks.json
DATAIQ_URL=http://127.0.0.1:8000
# Orígenes de otro dominio que pueden llamar a la API desde el navegador (lista
# JSON). Vacío si el frontend llega por proxy (Vercel en producción, Angular en
# desarrollo); solo hace falta si la API vive en su propio dominio.
CORS_ORIGINS=[]
# Quién elige la acción del chat: fake (reglas por palabras clave, sin modelo) u
# ollama (el modelo del Servidor PC2).
LANGUAGE_MODEL=fake
# El filtro con clave del Servidor PC2 (Tailscale Funnel); en local, Ollama directo.
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_TIMEOUT=30

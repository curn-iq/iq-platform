// Base de datos de SIMIQ3D (PostgreSQL 18, su propio proyecto en Neon).
// Ids: UUIDv7 generado por la base de datos (uuidv7(), PostgreSQL 18+).
// Nombres en inglés (tablas en plural, snake_case); notas en español.
//
// SIMIQ3D no guarda técnicas, instrumental ni usuarios: eso es de DataIQ, y se
// pide por su API. Los ids de DataIQ que aparecen aquí (instrument_id,
// technique_id) no son claves foráneas: viven en otra base.

Enum chat_action {
  show_technique
  highlight_instrument
  describe_instrument
  show_clinical_data
  list_instruments
  answer    // respuesta en texto que no cambia la escena
  clarify   // pide precisar: en qué técnica, o si quiso decir otro nombre
  no_answer
}

Enum clinical_field {
  description         // para qué sirve
  indications
  complications
  anesthesia_position // anestesia y posición del paciente
}

Table model_mappings {
  id uuid [pk, default: `uuidv7()`]
  instrument_id uuid [not null, unique, note: 'instruments.id de DataIQ']
  model_file Varchar [not null, note: 'GLB servido con el frontend, p. ej. pinza-kelly.glb']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Qué modelo 3D dibuja cada instrumento. Un instrumento tiene un solo modelo.'
}

Table chat_logs {
  id uuid [pk, default: `uuidv7()`]
  question Text [not null]
  open_technique_id uuid [note: 'La técnica abierta cuando se preguntó (contexto que manda el frontend)']
  action chat_action [not null]
  technique_id uuid [note: 'techniques.id de DataIQ, si la acción la usa']
  instrument_id uuid [note: 'instruments.id de DataIQ, si la acción lo usa']
  field clinical_field [note: 'Solo en show_clinical_data']
  language_model Varchar [not null, note: 'Qué modelo eligió la acción, p. ej. qwen3:8b']
  latency_ms Int [not null, note: 'Desde que llega la pregunta hasta la respuesta']
  created_at timestamptz [not null, default: `now()`]

  checks {
    `latency_ms >= 0` [name: 'latency_not_negative']
    `(field IS NOT NULL) = (action = 'show_clinical_data')` [name: 'field_only_for_clinical_data']
  }

  Note: '''
  Registro anónimo de las conversaciones, para medir la exactitud del chat y su
  tiempo de respuesta. No guarda la cuenta ni nada que identifique a quien
  pregunta. Solo se llena con CHAT_LOG_ENABLED=true (sesiones de evaluación y
  prueba piloto, con consentimiento informado) y se borra al terminar la
  evaluación.
  '''
}

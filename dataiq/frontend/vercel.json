{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/dataiq/:path*", "destination": "https://dataiq-backend.vercel.app/:path*" },
    { "source": "/api/simiq3d/:path*", "destination": "https://simiq3d-backend.vercel.app/:path*" },
    { "source": "/simiq3d/", "destination": "https://simiq3d-frontend.vercel.app/simiq3d/" },
    {
      "source": "/simiq3d/:path*",
      "destination": "https://simiq3d-frontend.vercel.app/simiq3d/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/|simiq3d).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/([^/]+)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}

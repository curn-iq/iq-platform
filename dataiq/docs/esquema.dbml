// Ids: UUIDv7 generado por la base de datos (uuidv7(), PostgreSQL 18+).
// Da a cada registro una identidad única entre instancias de DataIQ.
// Nombres en inglés (tablas en plural, snake_case); notas en español.

Enum user_role {
  user
  contributor
  reviewer
  admin
}

Enum version_state {
  draft
  in_review
  published
  superseded
  archived
}

Table users {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null]
  email Varchar [not null, unique]
  password_hash Varchar [not null]
  role user_role [not null, default: 'user']
  created_at timestamptz [not null, default: `now()`]
  policy_accepted_at timestamptz [not null]
  policy_version Varchar [not null]

  Note: '''
  policy_accepted_at y policy_version son la prueba de la autorización de
  tratamiento de datos personales (Decreto 1377 de 2013, art. 8).
  '''
}

Table specialties {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null, unique]
}

Table techniques {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null]
  specialty_id uuid [not null, ref: > specialties.id]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (name, specialty_id) [unique]
  }
}

Table technique_versions {
  id uuid [pk, default: `uuidv7()`]
  technique_id uuid [not null, ref: > techniques.id]
  number Int [not null]
  state version_state [not null, default: 'draft']
  cups_code Varchar
  anesthesia Varchar
  patient_position Varchar
  drapes Varchar
  description Text
  indications Text
  complications Text
  surgical_technique Text
  source Text [note: 'De dónde salió el contenido de la versión (enlaces o libros)']
  created_by uuid [not null, ref: > users.id]
  reviewed_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz

  indexes {
    (technique_id, number) [unique]
  }

  checks {
    `(state IN ('draft', 'in_review')) = (reviewed_by IS NULL AND reviewed_at IS NULL)` [name: 'review_consistent']
  }

  Note: '''
  Índices únicos parciales (DBML no los soporta, van en la migración):
  CREATE UNIQUE INDEX one_published_per_technique ON technique_versions (technique_id) WHERE state = 'published';
  CREATE UNIQUE INDEX one_in_progress_per_technique ON technique_versions (technique_id) WHERE state IN ('draft', 'in_review');
  '''
}

Table version_rejections {
  id uuid [pk, default: `uuidv7()`]
  version_id uuid [not null, ref: > technique_versions.id]
  rejected_by uuid [not null, ref: > users.id]
  reason Text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    version_id
  }

  checks {
    `btrim(reason) <> ''` [name: 'reason_not_empty']
  }

  Note: 'Cada vez que un revisor devuelve una versión en revisión: quién, por qué y cuándo. La versión vuelve a borrador.'
}

Table instrument_categories {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null, unique]
}

Table instruments {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null, unique]
  category_id uuid [not null, ref: > instrument_categories.id]
  description Varchar
  description_source Text [note: 'De dónde sale la descripción (enlaces o libros)']
}

Table instrument_aliases {
  id uuid [pk, default: `uuidv7()`]
  instrument_id uuid [not null, ref: > instruments.id]
  alias Varchar [not null, unique]
}

Table zones {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null, unique]
}

Table version_zones {
  version_id uuid [ref: > technique_versions.id]
  zone_id uuid [ref: > zones.id]
  used Boolean [not null]
  grid_rows Int
  grid_columns Int

  indexes {
    (version_id, zone_id) [pk]
  }

  checks {
    `used = (grid_rows IS NOT NULL AND grid_columns IS NOT NULL)` [name: 'size_when_used']
    `(grid_rows IS NULL OR grid_rows >= 1) AND (grid_columns IS NULL OR grid_columns >= 1)` [name: 'valid_size']
  }

  Note: '''
  Lo que la versión dice de cada mesa. used = false es «no lleva» (la técnica
  no usa esa mesa), distinto de no tener fila. Si la lleva, grid_rows y
  grid_columns son el tamaño de su grilla. Que los objetos y sus celdas caigan
  en una mesa que se lleva y dentro de su tamaño se valida en el dominio.
  '''
}

Table technique_items {
  id uuid [pk, default: `uuidv7()`]
  version_id uuid [not null, ref: > technique_versions.id]
  zone_id uuid [ref: >? zones.id]
  legend_number Int
  source_text Varchar [not null]

  indexes {
    (version_id, zone_id, legend_number) [unique]
    (id, version_id, zone_id) [unique]
  }

  checks {
    `legend_number IS NULL OR zone_id IS NOT NULL` [name: 'number_requires_zone']
  }

  Note: '''
  Cada mesa tiene su propia numeración (Mayo 1..n, Reserva 1..m): zone_id dice
  a qué mesa pertenece el número. Un objeto solo del listado no tiene ni mesa
  ni número.
  '''
}

Table item_components {
  id uuid [pk, default: `uuidv7()`]
  item_id uuid [not null, ref: > technique_items.id]
  instrument_id uuid [ref: >? instruments.id]
  suture_id uuid [ref: >? sutures.id]

  checks {
    `num_nonnulls(instrument_id, suture_id) = 1` [name: 'component_exactly_one']
  }
}

Table item_cells {
  id uuid [pk, default: `uuidv7()`]
  item_id uuid [not null]
  version_id uuid [not null]
  zone_id uuid [not null, ref: > zones.id]
  grid_row Int [not null]
  grid_column Int [not null]

  indexes {
    (version_id, zone_id, grid_row, grid_column) [unique]
  }

  checks {
    `grid_row >= 1 AND grid_column >= 1` [name: 'valid_cell']
  }

  Note: '''
  grid_row y grid_column (no row y column): column es palabra reservada en SQL.
  '''
}

Ref: item_cells.(item_id, version_id, zone_id) > technique_items.(id, version_id, zone_id)

Table sutures {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null]
  gauge Varchar
  needle_type Varchar

  indexes {
    (name, gauge, needle_type) [unique]
  }

  Note: '''
  El UNIQUE (name, gauge, needle_type) va con NULLS NOT DISTINCT
  (PostgreSQL 15+; DBML no lo soporta, se declara en el modelo): dos suturas
  con los mismos datos y los mismos campos vacíos cuentan como repetidas.
  '''
}

Table version_sutures {
  version_id uuid [ref: > technique_versions.id]
  suture_id uuid [ref: > sutures.id]
  usage Text

  indexes {
    (version_id, suture_id) [pk]
  }
}

Table biomedical_equipment {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null, unique]
  description Varchar
}

Table version_equipment {
  version_id uuid [ref: > technique_versions.id]
  equipment_id uuid [ref: > biomedical_equipment.id]

  indexes {
    (version_id, equipment_id) [pk]
  }
}

Table medical_devices {
  id uuid [pk, default: `uuidv7()`]
  name Varchar [not null, unique]
  description Varchar
}

Table version_devices {
  version_id uuid [ref: > technique_versions.id]
  device_id uuid [ref: > medical_devices.id]

  indexes {
    (version_id, device_id) [pk]
  }
}

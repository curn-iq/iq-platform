// Ids: UUIDv7 generado por la base de datos (uuidv7(), PostgreSQL 18+).
// Da a cada registro una identidad única entre instancias de DataIQ.

Enum rol_usuario {
  usuario
  colaborador
  revisor
  admin
}

Enum estado_version {
  borrador
  en_revision
  publicada
  reemplazada
  archivada
}

Table Usuario {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null]
  email Varchar [not null, unique]
  password_hash Varchar [not null]
  rol rol_usuario [not null, default: 'usuario']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_aceptacion_politica timestamptz [not null]
  version_politica Varchar [not null]

  Note: '''
  fecha_aceptacion_politica y version_politica son la prueba de la autorización
  de tratamiento de datos personales (Decreto 1377 de 2013, art. 8).
  '''
}

Table Especialidad {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null, unique]
}

Table Tecnica {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null]
  especialidad_id uuid [not null, ref: > Especialidad.id]
  creado_por uuid [not null, ref: > Usuario.id]
  fecha_creacion timestamptz [not null, default: `now()`]

  indexes {
    (nombre, especialidad_id) [unique]
  }
}

Table TecnicaVersion {
  id uuid [pk, default: `uuidv7()`]
  tecnica_id uuid [not null, ref: > Tecnica.id]
  numero Int [not null]
  estado estado_version [not null, default: 'borrador']
  codigo_cups Varchar
  anestesia Varchar
  posicion_paciente Varchar
  ropa Varchar
  descripcion Text
  indicaciones Text
  complicaciones Text
  tecnica_quirurgica Text
  fuente Text [note: 'De dónde salió el contenido de la versión (enlaces o libros)']
  creado_por uuid [not null, ref: > Usuario.id]
  revisado_por uuid [ref: >? Usuario.id]
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_actualizacion timestamptz [not null, default: `now()`]
  fecha_revision timestamptz

  indexes {
    (tecnica_id, numero) [unique]
  }

  checks {
    `(estado IN ('borrador', 'en_revision')) = (revisado_por IS NULL AND fecha_revision IS NULL)` [name: 'revision_coherente']
  }

  Note: '''
  Índices únicos parciales (DBML no los soporta, van en la migración):
  CREATE UNIQUE INDEX una_publicada_por_tecnica ON "TecnicaVersion" (tecnica_id) WHERE estado = 'publicada';
  CREATE UNIQUE INDEX un_borrador_por_tecnica ON "TecnicaVersion" (tecnica_id) WHERE estado IN ('borrador', 'en_revision');
  '''
}

Table RechazoVersion {
  id uuid [pk, default: `uuidv7()`]
  version_id uuid [not null, ref: > TecnicaVersion.id]
  rechazado_por uuid [not null, ref: > Usuario.id]
  motivo Text [not null]
  fecha timestamptz [not null, default: `now()`]

  indexes {
    version_id
  }

  checks {
    `btrim(motivo) <> ''` [name: 'motivo_no_vacio']
  }

  Note: 'Cada vez que un revisor devuelve una versión en revisión: quién, por qué y cuándo. La versión vuelve a borrador.'
}

Table CategoriaInstrumental {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null, unique]
}

Table Instrumental {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null, unique]
  categoria_id uuid [not null, ref: > CategoriaInstrumental.id]
  descripcion Varchar
}

Table InstrumentalAlias {
  id uuid [pk, default: `uuidv7()`]
  instrumental_id uuid [not null, ref: > Instrumental.id]
  alias Varchar [not null, unique]
}

Table ItemTecnica {
  id uuid [pk, default: `uuidv7()`]
  version_id uuid [not null, ref: > TecnicaVersion.id]
  zona_id uuid [ref: >? Zona.id]
  numero_leyenda Int
  texto_fuente Varchar [not null]

  indexes {
    (version_id, zona_id, numero_leyenda) [unique]
    (id, version_id, zona_id) [unique]
  }

  checks {
    `numero_leyenda IS NULL OR zona_id IS NOT NULL` [name: 'numero_con_mesa']
  }

  Note: '''
  Cada mesa tiene su propia numeración (Mayo 1..n, Reserva 1..m): zona_id dice
  a qué mesa pertenece el número. Un objeto solo del listado no tiene ni mesa
  ni número.
  '''
}

Table ItemTecnicaComponente {
  id uuid [pk, default: `uuidv7()`]
  item_id uuid [not null, ref: > ItemTecnica.id]
  instrumental_id uuid [ref: >? Instrumental.id]
  sutura_id uuid [ref: >? Sutura.id]

  checks {
    `num_nonnulls(instrumental_id, sutura_id) = 1` [name: 'componente_exactamente_uno']
  }
}

Table Zona {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null, unique]
}

Table PosicionMesa {
  id uuid [pk, default: `uuidv7()`]
  item_id uuid [not null]
  version_id uuid [not null]
  zona_id uuid [not null, ref: > Zona.id]
  fila Int [not null]
  columna Int [not null]

  indexes {
    (version_id, zona_id, fila, columna) [unique]
  }

  checks {
    `fila >= 1 AND columna >= 1` [name: 'celda_valida']
  }
}

Ref: PosicionMesa.(item_id, version_id, zona_id) > ItemTecnica.(id, version_id, zona_id)

Table Sutura {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null]
  calibre Varchar
  tipo_aguja Varchar

  indexes {
    (nombre, calibre, tipo_aguja) [unique]
  }

  Note: '''
  El UNIQUE (nombre, calibre, tipo_aguja) va con NULLS NOT DISTINCT
  (PostgreSQL 15+; DBML no lo soporta, se declara en el modelo): dos suturas
  con los mismos datos y los mismos campos vacíos cuentan como repetidas.
  '''
}

Table TecnicaVersion_Sutura {
  version_id uuid [ref: > TecnicaVersion.id]
  sutura_id uuid [ref: > Sutura.id]
  uso Text

  indexes {
    (version_id, sutura_id) [pk]
  }
}

Table EquipoBiomedico {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null, unique]
  descripcion Varchar
}

Table TecnicaVersion_EquipoBiomedico {
  version_id uuid [ref: > TecnicaVersion.id]
  equipo_id uuid [ref: > EquipoBiomedico.id]

  indexes {
    (version_id, equipo_id) [pk]
  }
}

Table DispositivoMedico {
  id uuid [pk, default: `uuidv7()`]
  nombre Varchar [not null, unique]
  descripcion Varchar
}

Table TecnicaVersion_DispositivoMedico {
  version_id uuid [ref: > TecnicaVersion.id]
  dispositivo_id uuid [ref: > DispositivoMedico.id]

  indexes {
    (version_id, dispositivo_id) [pk]
  }
}

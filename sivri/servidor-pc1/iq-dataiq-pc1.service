[Unit]
Description=DataIQ local para SIVRI en PC1
Requires=iq-pc1-db@dataiq.service
After=iq-pc1-db@dataiq.service

[Service]
WorkingDirectory=%h/Projects/iq-platform/dataiq/backend
Environment=SQL_ECHO=false
ExecStart=%h/Projects/iq-platform/dataiq/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

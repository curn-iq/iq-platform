# Base de datos de SIVRI (local: el contenedor sivri-db, en el puerto 5434; en
# producción, su propio proyecto en Neon). Nunca la de DataIQ ni la de SIMIQ3D.
DATABASE_URL=postgresql+asyncpg://sivri:contraseña@localhost:5434/sivri
SQL_ECHO=false
# Backend de DataIQ (local: el de dataiq/backend corriendo en el puerto 8000).
# De ahí salen la clave pública para validar los JWT (DATAIQ_URL/.well-known/jwks.json)
# y el catálogo con las mesas.
DATAIQ_URL=http://127.0.0.1:8000
# Lo que DataIQ pone en cada JWT; un token con otros valores no es de aquí.
JWT_ISSUER=dataiq
JWT_AUDIENCE=iq-platform
# Orígenes de otro dominio que pueden llamar a la API desde el navegador (lista
# JSON). SIVRI corre en el Servidor PC1, en otro dominio que la página: aquí va
# el origen del shell; en desarrollo, el de la página local. Ejemplo:
# CORS_ORIGINS=["https://iq-platform.vercel.app","http://localhost:4200"]
CORS_ORIGINS=[]
# Quién reconoce el instrumental: fake (detector de pruebas, no ve nada o lee
# las detecciones de FAKE_DETECTIONS) o yolo (el modelo entrenado en MODEL_PATH;
# requiere `uv sync --extra yolo`).
DETECTOR=fake
MODEL_PATH=models/sivri.pt
FAKE_DETECTIONS=
# Confianza mínima de una detección y tamaño de entrada de YOLO.
CONFIDENCE=0.35
IMAGE_SIZE=640
# Lado mayor al que se reduce cada cuadro antes de procesarlo, y tope del cuadro.
MAX_IMAGE_SIDE=1280
MAX_UPLOAD_BYTES=8000000
# cpu o un dispositivo de PyTorch (cuda:0).
DEVICE=cpu
# Ancho del margen técnico (fracción del lado de la celda, a cada lado del borde)
# y diferencia de porcentaje que cuenta como «muy cerca» entre dos técnicas.
# Puntos de partida: se ajustan con la sesión de validación.
BOARD_PADDING=0.10
CELL_MARGIN=0.10
CLOSE_GAP=0.05
# Cada cuánto (segundos) se vuelve a leer de la base el mapeo clase → instrumento.
CLASS_MAP_TTL=60
# Dónde está el código fuente (AGPL-3.0): quien usa SIVRI por internet puede obtenerlo.
SOURCE_URL=https://github.com/curn-iq/iq-platform/tree/main/sivri
